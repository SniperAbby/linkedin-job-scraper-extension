{
  "manifest_version": 3,
  "name": "LinkedIn Job Link Scraper",
  "version": "1.0.0",
  "description": "Collects job posting links and real application links from LinkedIn job search results, walking through every page of pagination.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://www.linkedin.com/*", "<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkedIn Job Link Scraper"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
